# Copy to .env.local and fill in. .env.local is never committed.
# Jev (TypeSafe) classifies chat messages when the server runs with --live-jev.
TYPESAFE_API_KEY=
JEV_PROVIDER=typesafe
# Optional: the command that calls Jev's classify tool (JSON array). Default shown.
# HABILIN_JEV_COMMAND=["mcporter","call","jev.jev_classify"]
