# Copy to .env.local and fill in. .env.local is never committed. Empty values are ignored.
# Jev (TypeSafe) classifies chat messages when the server runs with --live-jev.
TYPESAFE_API_KEY=
JEV_PROVIDER=typesafe
# Command that calls Jev's classify tool (JSON array). Default: ["mcporter","call","jev.jev_classify"]
# To use the key above directly, point mcporter at an installed @jkudish/jev-mcp, for example:
# HABILIN_JEV_COMMAND=["mcporter","call","--stdio","node /path/to/@jkudish/jev-mcp/dist/index.js","jev_classify"]
# OpenRouter rewords the agent's fixed replies (only with --live-jev). It never chooses actions or amounts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
